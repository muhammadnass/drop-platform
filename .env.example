# ============================================================
# DROP LOGISTICS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/drop_logistics?schema=public"

# --- Auth ---
JWT_SECRET="replace_with_a_long_random_secret_min_64_chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# --- Next.js App ---
NEXTAUTH_SECRET="replace_with_another_long_random_secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Drop"

# --- Backend Server ---
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# --- Socket.io ---
SOCKET_PING_INTERVAL=10000
SOCKET_PING_TIMEOUT=5000

# --- Google Maps / Places / Distance Matrix ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
GOOGLE_MAPS_SERVER_KEY="your_google_maps_server_key"

# --- Stripe (Subscription Billing) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID="price_..."  # $20/month subscription price ID

# --- Pricing Defaults (overridden in DB via PlatformConfig) ---
BASE_FARE_NGN=1500
RATE_PER_KM_NGN=500
PLATFORM_COMMISSION_PCT=8

# --- Vehicle Tier Multipliers ---
TIER_MULTIPLIER_DROP_MINI=1.0
TIER_MULTIPLIER_DROP_FLEX=1.5
TIER_MULTIPLIER_DROP_MAX=2.2

# --- Email (e.g., Resend / SendGrid) ---
EMAIL_FROM="noreply@drop.ng"
RESEND_API_KEY="re_..."

# --- Storage (e.g., Cloudinary for avatars/receipts) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
